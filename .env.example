# Slack Configuration
# Slack Bot User OAuth Token (starts with xoxb-)
# Get this from: Slack App Settings > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token for Socket Mode (starts with xapp-)
# Get this from: Slack App Settings > Socket Mode > App-Level Token
SLACK_APP_TOKEN=xapp-your-app-token-here

# Jira Configuration (API Token authentication)
# Your Jira Cloud site URL
JIRA_SITE_URL=https://yourcompany.atlassian.net

# Email of the Atlassian account that created the API token
JIRA_USER_EMAIL=your-email@company.com

# Jira API Token
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Sentry Configuration (optional)
SENTRY_DSN=

# Logging Configuration
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=local

# LLM Configuration
LLM_PROVIDER=anthropic  # "anthropic" or "bedrock"

# Anthropic API (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock (if LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Model Configuration (optional, defaults shown)
LLM_MODEL_ORCHESTRATOR=claude-3-5-haiku-20241022
LLM_MODEL_MAIN=claude-3-7-sonnet-20250219
